{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Server=postgres;Port=5432;Database=evently;User Id=admin;Password=admin;",
    "Cache": "redis:6379",
    "MessageBroker": "amqp://guest:guest@rabbitmq:5672"
  },
  "AuthConfiguration": {
    "Key": "your_secret_key_here_change_it_please",
    "Issuer": "DevTips",
    "Audience": "DevTips"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:5341"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "Evently"
    }
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://jaeger:4318",
  "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf"
}
