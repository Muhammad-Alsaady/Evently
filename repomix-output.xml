        {
            logger.LogInformation("User with ID {UserId} not found", userId);
            return UserErrors.NotFound(userId);
        }

        logger.LogInformation("Retrieved user with ID: {UserId}", userId);
        return new UserResponse(user.Id, user.Email!);
    }
}
