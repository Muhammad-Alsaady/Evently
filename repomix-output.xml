// This namespace and interfaces mirror Waseet.CQRS API
// When upgrading to .NET 10, replace this file with the Waseet.CQRS NuGet package
using Microsoft.Extensions.DependencyInjection;

namespace Waseet.CQRS;

/// <summary>
/// Default implementation of IMediator.
/// Compatible with Waseet.CQRS Mediator
/// </summary>
public sealed class Mediator : IMediator
{
    private readonly IServiceProvider _serviceProvider;

    public Mediator(IServiceProvider serviceProvider)
    {
        _serviceProvider = serviceProvider;
    }

    public async Task<TResponse> Send<TResponse>(
        IRequest<TResponse> request,
        CancellationToken cancellationToken = default)
    {
        var requestType = request.GetType();
        var handlerType = typeof(IRequestHandler<,>).MakeGenericType(requestType, typeof(TResponse));

        var handler = _serviceProvider.GetService(handlerType)
            ?? throw new InvalidOperationException($"No handler registered for {requestType.Name}");

        // Get pipeline behaviors
        var behaviorType = typeof(IPipelineBehavior<,>).MakeGenericType(requestType, typeof(TResponse));
        var behaviors = _serviceProvider.GetServices(behaviorType).Cast<object>().ToList();

        // Build the pipeline
        RequestHandlerDelegate<TResponse> pipeline = () =>
        {
            var handleMethod = handlerType.GetMethod("Handle")!;
            return (Task<TResponse>)handleMethod.Invoke(handler, [request, cancellationToken])!;
        };

        // Wrap behaviors in reverse order
        foreach (var behavior in behaviors.AsEnumerable().Reverse())
        {
            var currentPipeline = pipeline;
            var handleMethod = behaviorType.GetMethod("Handle")!;
            pipeline = () => (Task<TResponse>)handleMethod.Invoke(behavior, [request, currentPipeline, cancellationToken])!;
        }

        return await pipeline();
    }
}
