	{
		Code = code;
		Description = description;
		Type = type;
	}

	private Error(string code, string description, int numericType)
	{
		Code = code;
		Description = description;
		NumericType = numericType;

		Type = ErrorType.Custom;
	}

	/// <summary>
	/// Gets the unique error code.
	/// </summary>
	public string Code { get; }

